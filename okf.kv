#:kivy 2.3.0

<WaveformView>:
    canvas.before:
        Color:
            rgba: 0.11, 0.13, 0.15, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]

<RootWidget>:
    orientation: "vertical"
    md_bg_color: app.theme_cls.bg_darkest

    MDTopAppBar:
        title: "OKF — Octave Key Finder"
        elevation: 4
        left_action_items: [["waveform", lambda x: None]]

    MDBoxLayout:
        orientation: "vertical"
        padding: "20dp"
        spacing: "16dp"

        MDCard:
            id: waveform_card
            orientation: "vertical"
            padding: "8dp"
            radius: [12]
            size_hint_y: 0.35
            elevation: 1

            WaveformView:
                id: waveform
                waveform_data: root.waveform_data

        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "120dp"
            spacing: "16dp"

            MDCard:
                orientation: "vertical"
                padding: "16dp"
                radius: [12]
                elevation: 1

                MDLabel:
                    text: "BPM"
                    theme_text_color: "Secondary"
                    font_style: "Caption"
                    size_hint_y: None
                    height: "18dp"

                MDLabel:
                    text: root.bpm_text
                    font_style: "H4"
                    bold: True

            MDCard:
                orientation: "vertical"
                padding: "16dp"
                radius: [12]
                elevation: 1

                MDLabel:
                    text: "Key"
                    theme_text_color: "Secondary"
                    font_style: "Caption"
                    size_hint_y: None
                    height: "18dp"

                MDLabel:
                    text: root.key_text
                    font_style: "H4"
                    bold: True

        MDLabel:
            text: root.confidence_text
            theme_text_color: "Secondary"
            font_style: "Caption"
            size_hint_y: None
            height: "20dp"

        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "48dp"
            spacing: "16dp"

            MDRaisedButton:
                text: "Open WAV file"
                on_release: root.open_filechooser()
                disabled: root.is_busy
                size_hint_x: 1

            MDRaisedButton:
                text: "Separate stems"
                on_release: root.run_separation()
                disabled: root.is_busy or not root.current_filepath
                md_bg_color: app.theme_cls.accent_color
                size_hint_x: 1

        MDLabel:
            text: root.separation_mode_text
            theme_text_color: "Secondary"
            font_style: "Caption"
            size_hint_y: None
            height: "18dp"

        MDLabel:
            text: root.status_text
            font_style: "Body1"
            size_hint_y: None
            height: "56dp"
