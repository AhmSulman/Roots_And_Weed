#:kivy 2.3.0

<WaveformView>:
    canvas.before:
        Color:
            rgba: 0.14, 0.07, 0.07, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14]

<RootWidget>:
    orientation: "vertical"
    md_bg_color: app.theme_cls.bg_darkest

    MDTopAppBar:
        title: "Roots and Weed"
        elevation: 6
        left_action_items: [["sprout", lambda x: None]]
        md_bg_color: app.theme_cls.primary_dark

    MDBottomNavigation:
        id: bottom_nav
        panel_color: app.theme_cls.bg_dark
        text_color_normal: 0.62, 0.5, 0.5, 1
        text_color_active: app.theme_cls.accent_color

        MDBottomNavigationItem:
            name: "analyze"
            text: "Analyze"
            icon: "waveform"

            MDBoxLayout:
                orientation: "vertical"
                padding: "20dp"
                spacing: "16dp"

                MDCard:
                    id: waveform_card
                    orientation: "vertical"
                    padding: "8dp"
                    radius: [14]
                    size_hint_y: 0.35
                    elevation: 3
                    md_bg_color: 0.19, 0.10, 0.10, 1
                    line_color: app.theme_cls.primary_color

                    WaveformView:
                        id: waveform
                        waveform_data: root.waveform_data

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "120dp"
                    spacing: "16dp"

                    MDCard:
                        orientation: "vertical"
                        padding: "16dp"
                        radius: [14]
                        elevation: 3
                        md_bg_color: 0.19, 0.10, 0.10, 1

                        MDLabel:
                            text: "BPM"
                            font_name: "HeadingFont"
                            theme_text_color: "Secondary"
                            font_style: "Caption"
                            size_hint_y: None
                            height: "18dp"

                        MDLabel:
                            text: root.bpm_text
                            font_name: "ReadoutFont"
                            font_style: "H4"
                            theme_text_color: "Primary"

                    MDCard:
                        orientation: "vertical"
                        padding: "16dp"
                        radius: [14]
                        elevation: 3
                        md_bg_color: 0.19, 0.10, 0.10, 1

                        MDLabel:
                            text: "Key"
                            font_name: "HeadingFont"
                            theme_text_color: "Secondary"
                            font_style: "Caption"
                            size_hint_y: None
                            height: "18dp"

                        MDLabel:
                            text: root.key_text
                            font_name: "ReadoutFont"
                            font_style: "H4"
                            theme_text_color: "Primary"

                MDLabel:
                    text: root.confidence_text
                    font_name: "ReadoutFont"
                    theme_text_color: "Secondary"
                    font_style: "Caption"
                    size_hint_y: None
                    height: "20dp"

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "48dp"
                    spacing: "16dp"

                    MDRaisedButton:
                        text: "Open WAV / MP3 file"
                        font_name: "HeadingFont"
                        icon: "folder-music"
                        on_release: root.open_wav_chooser()
                        disabled: root.is_busy
                        size_hint_x: 1

                    MDRaisedButton:
                        text: "Separate stems"
                        font_name: "HeadingFont"
                        icon: "call-split"
                        on_release: root.run_separation()
                        disabled: root.is_busy or not root.current_filepath
                        md_bg_color: app.theme_cls.accent_color
                        size_hint_x: 1

                MDProgressBar:
                    id: sep_progress
                    value: root.separation_progress
                    size_hint_y: None
                    height: "6dp"
                    opacity: 1 if root.separating else 0
                    color: app.theme_cls.accent_color

                MDLabel:
                    text: root.separation_mode_text
                    font_name: "HeadingFont"
                    theme_text_color: "Secondary"
                    font_style: "Caption"
                    size_hint_y: None
                    height: "18dp"

                MDLabel:
                    text: root.status_text
                    font_name: "HeadingFont"
                    font_style: "Body1"
                    size_hint_y: None
                    height: "56dp"

        MDBottomNavigationItem:
            name: "convert"
            text: "Convert"
            icon: "file-music"

            MDBoxLayout:
                orientation: "vertical"
                padding: "24dp"
                spacing: "20dp"

                MDLabel:
                    text: "MP3 -> WAV converter"
                    font_name: "HeadingFont"
                    font_style: "H5"
                    bold: True
                    size_hint_y: None
                    height: "36dp"

                MDLabel:
                    text: "The analyzer now reads MP3 directly — this converter is optional. Use it when you want a saved WAV file on disk."
                    font_name: "HeadingFont"
                    theme_text_color: "Secondary"
                    font_style: "Body2"
                    size_hint_y: None
                    height: "72dp"
                    text_size: self.width, None

                MDCard:
                    orientation: "vertical"
                    padding: "16dp"
                    spacing: "12dp"
                    radius: [14]
                    elevation: 3
                    md_bg_color: 0.19, 0.10, 0.10, 1
                    size_hint_y: None
                    height: "160dp"

                    MDLabel:
                        text: root.convert_source_name if root.convert_source_name else "No MP3 selected"
                        font_name: "ReadoutFont"
                        font_style: "Subtitle1"

                    MDLabel:
                        text: root.convert_status_text
                        font_name: "HeadingFont"
                        theme_text_color: "Secondary"
                        font_style: "Body2"
                        text_size: self.width, None

                    MDBoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: "48dp"
                        spacing: "12dp"

                        MDRaisedButton:
                            text: "Choose MP3"
                            font_name: "HeadingFont"
                            icon: "file-music-outline"
                            on_release: root.open_mp3_chooser()
                            disabled: root.convert_busy
                            size_hint_x: 1

                        MDRaisedButton:
                            text: "Convert"
                            font_name: "HeadingFont"
                            icon: "autorenew"
                            on_release: root.run_conversion()
                            disabled: root.convert_busy or not root.convert_source_name or root.converted_wav_path
                            md_bg_color: app.theme_cls.accent_color
                            size_hint_x: 1

                MDRaisedButton:
                    text: "Use in Analyzer"
                    font_name: "HeadingFont"
                    icon: "arrow-right-bold"
                    on_release: root.use_converted_in_analyzer()
                    disabled: not root.converted_wav_path
                    pos_hint: {"center_x": 0.5}
